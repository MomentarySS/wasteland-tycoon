{
  "name": "wasteland-tycoon",
  "version": "1.7.1",
  "description": "废土大亨：末世大富翁 · Windows 桌面客户端（Electron）",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "pretest": "node scripts/sync-www.mjs",
    "test": "node smoke.test.mjs",
    "sync:www": "node scripts/sync-www.mjs",
    "voice:list": "node scripts/gen-voice.mjs --list",
    "voice:export": "node scripts/gen-voice.mjs --export-tasks",
    "voice:manifest": "node scripts/gen-voice.mjs --manifest-only",
    "voice:audition": "node scripts/gen-voice.mjs --audition",
    "voice:gen": "node scripts/gen-voice.mjs",
    "tts:minimax": "node scripts/test-minimax-tts.mjs",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:build": "node scripts/build-desktop.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron": "44.5.0",
    "electron-builder": "^25.0.0",
    "sharp": "^0.34.5"
  },
  "build": {
    "appId": "com.bigxstudio.wasteland-tycoon",
    "productName": "废土大亨",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "www/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
